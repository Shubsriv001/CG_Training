@model LpuApplicationForm.Models.StudentModel
@{
    ViewData["Title"] = Model.StudentId == 0 ? "Student Application Form" : "Edit Application";
}

<style>
    .application-form {
        max-width: 900px;
        margin: 30px auto;
        background: white;
        padding: 40px;
        border-radius: 10px;
        box-shadow: 0 0 20px rgba(0,0,0,0.1);
    }
    
    .form-header {
        text-align: center;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 3px solid #1e3c72;
    }
    
    .form-header h1 {
        color: #1e3c72;
        font-size: 28px;
        font-weight: bold;
        margin-bottom: 5px;
    }
    
    .form-header p {
        color: #666;
        font-size: 14px;
        margin: 0;
    }
    
    .section-title {
        background: #f0f4ff;
        padding: 10px 15px;
        margin: 25px 0 15px 0;
        border-left: 4px solid #1e3c72;
        font-weight: bold;
        color: #1e3c72;
    }
    
    .form-label {
        font-weight: 600;
        color: #333;
        margin-bottom: 5px;
    }
    
    .required-field::after {
        content: " *";
        color: red;
    }
    
    .form-control, .form-select {
        border: 1px solid #ddd;
        border-radius: 5px;
        padding: 10px;
    }
    
    .form-control:focus, .form-select:focus {
        border-color: #1e3c72;
        box-shadow: 0 0 0 0.2rem rgba(30, 60, 114, 0.25);
    }
    
    .btn-submit {
        background: #1e3c72;
        color: white;
        padding: 12px 40px;
        border: none;
        border-radius: 5px;
        font-size: 16px;
        font-weight: bold;
    }
    
    .btn-submit:hover {
        background: #2a5298;
        color: white;
    }
    
    .photo-preview {
        max-width: 150px;
        border: 2px solid #1e3c72;
        border-radius: 5px;
        padding: 5px;
    }
</style>

<div class="application-form">
    <div class="form-header">
        <h1>🎓 LOVELY PROFESSIONAL UNIVERSITY</h1>
        <p>Student Application Form - Academic Year @DateTime.Now.Year</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="@(Model.StudentId == 0 ? "Create" : "Edit")" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="StudentId" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="section-title">📋 Personal Information</div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="FullName" class="form-label required-field">Full Name</label>
                <input asp-for="FullName" class="form-control" placeholder="Enter full name as per documents" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="col-md-3 mb-3">
                <label asp-for="Gender" class="form-label required-field">Gender</label>
                <select asp-for="Gender" class="form-select">
                    <option value="">-- Select --</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>

            <div class="col-md-3 mb-3">
                <label asp-for="DOB" class="form-label required-field">Date of Birth</label>
                <input asp-for="DOB" class="form-control" type="date" />
                <span asp-validation-for="DOB" class="text-danger"></span>
            </div>
        </div>

        <div class="section-title">📞 Contact Information</div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Email" class="form-label required-field">Email Address</label>
                <input asp-for="Email" class="form-control" type="email" placeholder="student@example.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Mobile" class="form-label required-field">Mobile Number</label>
                <input asp-for="Mobile" class="form-control" placeholder="10-digit mobile number" maxlength="10" />
                <span asp-validation-for="Mobile" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Address" class="form-label required-field">Residential Address</label>
            <textarea asp-for="Address" class="form-control" rows="3" placeholder="Enter complete address"></textarea>
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="City" class="form-label required-field">City</label>
                <input asp-for="City" class="form-control" placeholder="City name" />
                <span asp-validation-for="City" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="State" class="form-label required-field">State</label>
                <input asp-for="State" class="form-control" placeholder="State name" />
                <span asp-validation-for="State" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Pincode" class="form-label required-field">Pincode</label>
                <input asp-for="Pincode" class="form-control" placeholder="6-digit pincode" maxlength="6" />
                <span asp-validation-for="Pincode" class="text-danger"></span>
            </div>
        </div>

        <div class="section-title">🎓 Academic Information</div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="CourseApplied" class="form-label required-field">Course Applied For</label>
                <select asp-for="CourseApplied" class="form-select">
                    <option value="">-- Select Course --</option>
                    <optgroup label="Engineering">
                        <option value="B.Tech Computer Science">B.Tech Computer Science</option>
                        <option value="B.Tech Mechanical">B.Tech Mechanical Engineering</option>
                        <option value="B.Tech Civil">B.Tech Civil Engineering</option>
                        <option value="B.Tech Electronics">B.Tech Electronics & Communication</option>
                    </optgroup>
                    <optgroup label="Management">
                        <option value="BBA">Bachelor of Business Administration (BBA)</option>
                        <option value="MBA">Master of Business Administration (MBA)</option>
                    </optgroup>
                    <optgroup label="Computer Applications">
                        <option value="BCA">Bachelor of Computer Applications (BCA)</option>
                        <option value="MCA">Master of Computer Applications (MCA)</option>
                    </optgroup>
                </select>
                <span asp-validation-for="CourseApplied" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="HighSchoolMarks" class="form-label required-field">10th Grade Marks (%)</label>
                <input asp-for="HighSchoolMarks" class="form-control" type="number" step="0.01" placeholder="0-100" />
                <span asp-validation-for="HighSchoolMarks" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="IntermediateMarks" class="form-label required-field">12th Grade Marks (%)</label>
                <input asp-for="IntermediateMarks" class="form-control" type="number" step="0.01" placeholder="0-100" />
                <span asp-validation-for="IntermediateMarks" class="text-danger"></span>
            </div>
        </div>

        <div class="section-title">📸 Profile Photograph</div>

        <div class="mb-3">
            <label asp-for="ProfileFile" class="form-label required-field">Upload Photo</label>
            <input asp-for="ProfileFile" class="form-control" type="file" accept=".jpg,.jpeg,.png" />
            <small class="form-text text-muted">
                Requirements: 500x500 pixels, Maximum 3MB, JPG/PNG format only
            </small>
            <span asp-validation-for="ProfileFile" class="text-danger d-block"></span>
            @if (Model.ProfileImage != null)
            {
                <div class="mt-3">
                    <p class="mb-2"><strong>Current Photo:</strong></p>
                    @{
                        var base64 = Convert.ToBase64String(Model.ProfileImage);
                        var imgSrc = $"data:image/{Model.ImageExtension?.TrimStart('.')};base64,{base64}";
                    }
                    <img src="@imgSrc" alt="Current Profile" class="photo-preview" />
                </div>
            }
        </div>

        <div class="section-title">📝 Declaration</div>
        <div class="alert alert-info">
            <small>
                I hereby declare that all the information provided above is true and correct to the best of my knowledge. 
                I understand that any false information may lead to cancellation of my admission.
            </small>
        </div>

        <div class="text-center mt-4">
            <button type="submit" class="btn btn-submit">
                @(Model.StudentId == 0 ? "✓ Submit Application" : "✓ Update Application")
            </button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
