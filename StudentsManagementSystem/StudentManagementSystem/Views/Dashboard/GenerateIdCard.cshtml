@model Student

@{
    ViewData["Title"] = "Student ID Card";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card" style="border: 3px solid #003366;">
                <div class="card-header bg-primary text-white text-center" style="background: linear-gradient(135deg, #003366 0%, #0066cc 100%);">
                    <h3 class="mb-0">STUDENT ID CARD</h3>
                    <p class="mb-0" style="font-size: 0.9rem;">Official Document</p>
                </div>
                <div class="card-body" style="padding: 30px;">
                    <div style="border: 2px dashed #333; padding: 20px; text-align: center;">
                        <table style="width: 100%; margin-bottom: 15px;">
                            <tr>
                                <td style="padding: 8px; text-align: left;"><strong>Student ID:</strong></td>
                                <td style="padding: 8px; text-align: right;">@Model.StudentId</td>
                            </tr>
                            <tr style="background-color: #f0f0f0;">
                                <td style="padding: 8px; text-align: left;"><strong>Name:</strong></td>
                                <td style="padding: 8px; text-align: right;">@Model.StudentName</td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; text-align: left;"><strong>Father's Name:</strong></td>
                                <td style="padding: 8px; text-align: right;">@Model.FatherName</td>
                            </tr>
                            <tr style="background-color: #f0f0f0;">
                                <td style="padding: 8px; text-align: left;"><strong>Email:</strong></td>
                                <td style="padding: 8px; text-align: right; font-size: 0.9rem;">@Model.Email</td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; text-align: left;"><strong>Phone:</strong></td>
                                <td style="padding: 8px; text-align: right;">@Model.Phone</td>
                            </tr>
                            <tr style="background-color: #f0f0f0;">
                                <td style="padding: 8px; text-align: left;"><strong>Semester:</strong></td>
                                <td style="padding: 8px; text-align: right;">@Model.Semester</td>
                            </tr>
                        </table>

                        @if (Model.Hostel != null)
                        {
                            <hr style="margin: 15px 0;">
                            <h6 style="text-align: center; margin-bottom: 10px;"><strong>Hostel Details</strong></h6>
                            <table style="width: 100%;">
                                <tr>
                                    <td style="padding: 8px; text-align: left;"><strong>Hostel:</strong></td>
                                    <td style="padding: 8px; text-align: right;">@Model.Hostel.HostelName</td>
                                </tr>
                                <tr style="background-color: #f0f0f0;">
                                    <td style="padding: 8px; text-align: left;"><strong>Room No:</strong></td>
                                    <td style="padding: 8px; text-align: right;">@Model.Hostel.RoomNumber</td>
                                </tr>
                            </table>
                        }
                        else
                        {
                            <hr style="margin: 15px 0;">
                            <p style="color: #666;">No Hostel Assigned</p>
                        }

                        <hr style="margin: 15px 0;">
                        <p style="font-size: 0.8rem; color: #666;">
                            Issued: @DateTime.Now.ToString("dd/MM/yyyy")<br>
                            Valid Throughout Academic Year
                        </p>
                    </div>
                </div>
                <div class="card-footer text-center">
                    <button onclick="window.print()" class="btn btn-primary">Print</button>
                    <a href="/dashboard/id-card-pdf/@Model.StudentId" class="btn btn-danger">Download PDF</a>
                    <a href="/dashboard" class="btn btn-secondary">Back to Dashboard</a>
                </div>
            </div>
        </div>
    </div>
</div>
