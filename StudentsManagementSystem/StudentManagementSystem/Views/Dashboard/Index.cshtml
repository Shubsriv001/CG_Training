@model Student

@{
    ViewData["Title"] = "Student Dashboard";
}

<div class="container mt-5">
    @if (Model == null)
    {
        <div class="alert alert-warning">
            <h4>Welcome!</h4>
            <p>Please complete your student registration to continue.</p>
            <a href="/student/register-form" class="btn btn-primary">Complete Registration</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-12">
                <div class="card shadow mb-4">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">Student Dashboard</h4>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h5>Personal Information</h5>
                                <table class="table table-sm">
                                    <tr>
                                        <th>Student ID:</th>
                                        <td>@Model.StudentId</td>
                                    </tr>
                                    <tr>
                                        <th>Name:</th>
                                        <td>@Model.StudentName</td>
                                    </tr>
                                    <tr>
                                        <th>Father's Name:</th>
                                        <td>@Model.FatherName</td>
                                    </tr>
                                    <tr>
                                        <th>Email:</th>
                                        <td>@Model.Email</td>
                                    </tr>
                                    <tr>
                                        <th>Phone:</th>
                                        <td>@Model.Phone</td>
                                    </tr>
                                    <tr>
                                        <th>Date of Birth:</th>
                                        <td>@Model.DateOfBirth.ToString("dd/MM/yyyy")</td>
                                    </tr>
                                    <tr>
                                        <th>Address:</th>
                                        <td>@(string.IsNullOrEmpty(Model.Address) ? "N/A" : Model.Address)</td>
                                    </tr>
                                </table>
                            </div>

                            <div class="col-md-6">
                                <h5>Academic Information</h5>
                                <table class="table table-sm">
                                    <tr>
                                        <th>Semester:</th>
                                        <td>@Model.Semester</td>
                                    </tr>
                                    <tr>
                                        <th>Subject 1:</th>
                                        <td>@Model.Subject1Marks</td>
                                    </tr>
                                    <tr>
                                        <th>Subject 2:</th>
                                        <td>@Model.Subject2Marks</td>
                                    </tr>
                                    <tr>
                                        <th>Subject 3:</th>
                                        <td>@Model.Subject3Marks</td>
                                    </tr>
                                    <tr>
                                        <th>Subject 4:</th>
                                        <td>@Model.Subject4Marks</td>
                                    </tr>
                                    <tr>
                                        <th>Subject 5:</th>
                                        <td>@Model.Subject5Marks</td>
                                    </tr>
                                    <tr>
                                        <th><strong>Average Marks:</strong></th>
                                        <td><strong>@Model.AverageMarks.ToString("0.00")</strong></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        @if (Model.Hostel != null)
                        {
                            <div class="row mt-4">
                                <div class="col-md-6">
                                    <h5>Hostel Information</h5>
                                    <table class="table table-sm">
                                        <tr>
                                            <th>Hostel Name:</th>
                                            <td>@Model.Hostel.HostelName</td>
                                        </tr>
                                        <tr>
                                            <th>Room Number:</th>
                                            <td>@Model.Hostel.RoomNumber</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-md-12">
                        <a href="/student/edit/@Model.StudentId" class="btn btn-warning">Edit Information</a>
                        <a href="/dashboard/id-card/@Model.StudentId" class="btn btn-info">View ID Card</a>
                        <a href="/dashboard/id-card-pdf/@Model.StudentId" class="btn btn-danger">Download ID Card (PDF)</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
