@model IEnumerable<Student>

@{
    ViewData["Title"] = "Admin Dashboard - All Students";
}

<div class="container-fluid mt-5">
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Admin Dashboard - Student Management</h4>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <a href="/admin/manage-hostels" class="btn btn-info">Manage Hostels</a>
                        </div>
                        <div class="col-md-6 text-end">
                            <a href="/auth/logout" class="btn btn-warning">Logout</a>
                        </div>
                    </div>

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (!Model.Any())
                    {
                        <div class="alert alert-info">
                            No students registered yet.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Student ID</th>
                                        <th>Name</th>
                                        <th>Father Name</th>
                                        <th>Email</th>
                                        <th>Phone</th>
                                        <th>Semester</th>
                                        <th>Average Marks</th>
                                        <th>Hostel</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var student in Model)
                                    {
                                        <tr>
                                            <td>@student.StudentId</td>
                                            <td>@student.StudentName</td>
                                            <td>@student.FatherName</td>
                                            <td>@student.Email</td>
                                            <td>@student.Phone</td>
                                            <td>@student.Semester</td>
                                            <td>
                                                <span class="badge bg-primary">@student.AverageMarks.ToString("0.00")</span>
                                            </td>
                                            <td>
                                                @if (student.Hostel != null)
                                                {
                                                    <span>@student.Hostel.HostelName - @student.Hostel.RoomNumber</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not Assigned</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="/admin/view-student/@student.StudentId" class="btn btn-sm btn-info">View</a>
                                                <a href="/student/edit/@student.StudentId" class="btn btn-sm btn-warning">Edit</a>
                                                <a href="/dashboard/id-card-pdf/@student.StudentId" class="btn btn-sm btn-danger">ID Card</a>
                                                <form method="post" action="/student/delete/@student.StudentId" style="display: inline;" onsubmit="return confirm('Are you sure?');">
                                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
