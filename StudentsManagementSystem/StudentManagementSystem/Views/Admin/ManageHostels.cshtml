@model IEnumerable<Hostel>

@{
    ViewData["Title"] = "Manage Hostels";
}

<div class="container-fluid mt-5">
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">Manage Hostels</h4>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <a href="/admin/create-hostel" class="btn btn-success">Add New Hostel</a>
                        <a href="/admin" class="btn btn-secondary">Back to Admin Panel</a>
                    </div>

                    @if (!Model.Any())
                    {
                        <div class="alert alert-info">
                            No hostels available. <a href="/admin/create-hostel">Add one now</a>.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Hostel ID</th>
                                        <th>Hostel Name</th>
                                        <th>Room Number</th>
                                        <th>Address</th>
                                        <th>Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var hostel in Model)
                                    {
                                        <tr>
                                            <td>@hostel.HostelId</td>
                                            <td>@hostel.HostelName</td>
                                            <td>@hostel.RoomNumber</td>
                                            <td>@(string.IsNullOrEmpty(hostel.Address) ? "N/A" : hostel.Address)</td>
                                            <td>@hostel.CreatedAt.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                <a href="/admin/edit-hostel/@hostel.HostelId" class="btn btn-sm btn-warning">Edit</a>
                                                <form method="post" action="/admin/delete-hostel/@hostel.HostelId" style="display: inline;" onsubmit="return confirm('Are you sure?');">
                                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
